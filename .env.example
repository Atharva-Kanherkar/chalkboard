# Copy to .env at the repo root and fill in the keys you want to use.
# Both apps/server and apps/cli auto-load this file via Node's --env-file-if-exists.

# --- LLM providers (any one) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- TTS providers (optional) ---
# OPENAI_API_KEY is shared between LLM and TTS — set it once above.
# ELEVENLABS_API_KEY=...
# PIPER_BIN=/path/to/piper
# PIPER_MODEL=/path/to/en_US-lessac-medium.onnx

# --- Server ---
# PORT=4140
# HOST=0.0.0.0
# STORAGE_DIR=./out

# --- Forcing providers regardless of which keys are set ---
# CHALKBOARD_LLM=stub   # bypass the LLM entirely (canned SceneScript)
# CHALKBOARD_TTS=stub   # bypass TTS (sine-wave audio)
