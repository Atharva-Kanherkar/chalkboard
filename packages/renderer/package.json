{
  "name": "@chalkboard/renderer",
  "version": "0.1.0",
  "description": "Headless Chromium + ffmpeg renderer for chalkboard SceneScripts.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:graphviz": "tsx scripts/graphviz-smoke.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@chalkboard/shared": "workspace:*",
    "@chalkboard/whiteboard": "workspace:*",
    "@hpcc-js/wasm-graphviz": "^1.22.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
