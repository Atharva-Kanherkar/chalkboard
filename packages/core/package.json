{
  "name": "@chalkboard/core",
  "version": "0.1.0",
  "description": "Orchestrator: prompt → SceneScript → narration → render → mp4.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@chalkboard/llm": "workspace:*",
    "@chalkboard/narration": "workspace:*",
    "@chalkboard/renderer": "workspace:*",
    "@chalkboard/shared": "workspace:*",
    "@chalkboard/whiteboard": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
